	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hi</string>
		<string>bn</string>
		<string>ta</string>
		<string>te</string>
		<string>mr</string>
		<string>gu</string>
		<string>kn</string>
		<string>ml</string>
		<string>pa</string>
		<string>ar</string>
		<string>es</string>
		<string>fr</string>
		<string>pt</string>
		<string>de</string>
	</array>
	<key>CFBundleName</key>
	<string>FamilyHub</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
		<string>https</string>
		<string>comgooglemaps</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>FamilyHub uses the camera so you can take a profile photo or add a picture to a family notice.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>FamilyHub keeps sharing your live location with your family during an SOS, even if you switch to another app or lock your phone. It is never shared unless you choose to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FamilyHub shares your location with your family only when you send an SOS or turn on location sharing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FamilyHub lets you choose a photo for your profile or a family notice.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
