{
  "name": "family-hub-backend",
  "version": "1.0.0",
  "description": "FamilyHub REST API - Node.js (ES modules) + Express + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
