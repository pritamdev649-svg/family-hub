# Copy to .env and adjust. Never commit .env. (Not loaded when NODE_ENV=test.)

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma separated list of allowed CORS origins ("*" for dev; mobile apps don't need CORS,
# only a Flutter web build does). Example: https://app.familyhub.app,https://admin.familyhub.app
CORS_ORIGINS=*
APP_NAME=FamilyHub
# Express "trust proxy": false (direct), 1 (one proxy/load balancer hop), true, or a subnet.
# Needed behind a reverse proxy so rate limits see the real client IP.
TRUST_PROXY=false
# LOG_LEVEL=info   # debug | info | warn | error | silent
# RATE_LIMIT_IN_TEST=false   # enable rate limiters inside tests

# --- MongoDB ---
# No local MongoDB? Run `npm run dev:memory` (in-memory MongoDB, seeded, data lost on exit).
MONGODB_URI=mongodb://127.0.0.1:27017/familyhub

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
# Required in production (>= 32 chars). Dev/test fall back to an insecure built-in secret.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 32-byte key, base64 encoded, used to encrypt sensitive health fields at rest (AES-256-GCM).
# Required in production; changing it makes existing encrypted emergency-card fields unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# --- Email (SMTP). Leave SMTP_HOST empty in dev to print emails (incl. OTP codes) to the console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FamilyHub <no-reply@familyhub.app>"

# --- Firebase Cloud Messaging (push). Service-account JSON as a file path, or the JSON itself base64-encoded
# (base64 wins when both are set). Without either, push notifications are disabled. ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Cloudinary (signed direct image uploads). Without these, POST /uploads/signature returns 503. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- scripts/dev-memory.js only ---
# DEV_MEMORY_DB_PORT=27018   # fixed port for the in-memory MongoDB (e.g. to connect with Compass)
